# --- Serveur ---
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/grand-et-disciples

# Chaîne longue et aléatoire, obligatoire en production
JWT_SECRET=change-moi-en-production

# Code à fournir à l'inscription pour obtenir le rôle « enseignant »
TEACHER_CODE=disciples-2026

# Origines autorisées en développement (séparées par des virgules). Vide = toutes.
CLIENT_ORIGIN=

# --- Gemini (correction automatique, photo -> LaTeX) ---
# Laisser vide désactive proprement les fonctions IA.
# Une ou plusieurs clés, séparées par des virgules (une par projet Google).
# Si une clé atteint son quota, le serveur bascule tout seul sur la suivante.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
# Nombre maximal d'appels IA par élève et par heure
AI_HOURLY_LIMIT=30
